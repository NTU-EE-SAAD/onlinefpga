[Unit]
Description=OnlineFPGA borrowing website
After=network.target

[Service]
Type=simple
WorkingDirectory=@PROJECT_ROOT@
EnvironmentFile=-@PROJECT_ROOT@/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=@PROJECT_ROOT@/.venv/bin/gunicorn --workers 2 --bind 0.0.0.0:8000 --timeout 30 portal:create_app()
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
