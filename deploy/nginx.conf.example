# Install after replacing the domain and certificate paths.
# Bind Gunicorn to 127.0.0.1:8000 when using this proxy, and set:
# TRUST_PROXY=true, COOKIE_SECURE=true.
server {
    listen 80;
    server_name fpga.example.edu;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name fpga.example.edu;
    ssl_certificate /etc/letsencrypt/live/fpga.example.edu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fpga.example.edu/privkey.pem;
    client_max_body_size 32k;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 35s;
    }
}
