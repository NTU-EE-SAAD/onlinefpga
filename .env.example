# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE_PATH=instance/portal.sqlite3
TIMEZONE=Asia/Taipei
COOKIE_SECURE=false
TRUST_PROXY=false
REGISTRATION_OPEN=true
MAINTENANCE_START=06:00
MAINTENANCE_END=07:00
SCHEDULER_INTERVAL=10
# Physical hardware stays disabled until explicitly configured.
ENABLE_HARDWARE=false
FPGA_SSH_KEY=
FPGA_KNOWN_HOSTS=
# JSON keyed by device slug, mode 600; see README.
FPGA_CREDENTIALS=
